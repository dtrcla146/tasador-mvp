{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tasador MVP",
  "version": "2.0.0",
  "identifier": "cl.tasador.mvp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tasador MVP",
        "width": 1280,
        "height": 850,
        "minWidth": 360,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
